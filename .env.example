# Copy to .env. With every value empty the app still runs: bundled catalogue, demo payment, mock community.

# The shop (WooCommerce). Needs the "wrk. app bridge" plugin from /shop-bridge to place real orders.
EXPO_PUBLIC_WOO_BASE_URL=
# Moyasar PUBLISHABLE key (pk_test_... or pk_live_...). Never put the secret key in the app.
EXPO_PUBLIC_MOYASAR_PUBLISHABLE_KEY=

# Community backend (Supabase). See backend/README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_COMMUNITY_ENABLED=1

# Public addresses. Planned: wrk.sa (community), store.wrk.sa (store), corporate.wrk.sa (companies).
# Empty means the current shop address is used.
EXPO_PUBLIC_SOCIAL_URL=
EXPO_PUBLIC_STORE_URL=
EXPO_PUBLIC_CORPORATE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
